---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import ContactForm from "../components/ContactForm.astro";
---
<BaseLayout
  title="Kontakt — AMP-stroje, Brno"
  description="Popište nám váš provozní problém. Ozveme se přímo my, ne call centrum. Brno, Pražákova 1008/69."
  schema={{
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: "Kontakt — AMP-stroje",
  }}
>
  <Hero
    headline="Pojďme probrat váš projekt"
    subheadline="Napište, zavolejte, nebo vyplňte formulář — ozveme se přímo my, ne call centrum."
    size="small"
  />

  <Section variant="alt">
    <div class="grid grid--2 contact-grid">
      <div class="reveal">
        <ContactForm />
      </div>
      <div class="reveal contact-info" style="--reveal-index:1">
        <h2>Kontaktní osoba</h2>
        <div class="contact-person">
          <div class="media-placeholder contact-person__photo">FOTO: doplní AMP</div>
          <div>
            <p class="contact-person__name">Michal Holánek</p>
            <p class="placeholder-note">[DOPLNIT — role, přímý telefon, e-mail]</p>
          </div>
        </div>

        <h2>Adresa</h2>
        <address>
          AMP-stroje, s.r.o.<br />
          Pražákova 1008/69<br />
          Brno, 639 00<br />
          IČO: 19091842
        </address>

        <h2>Přímý kontakt</h2>
        <p>
          <a href="tel:+420777911077" data-event="phone_click">+420 777 911 077</a><br />
          <a href="mailto:info@amp-stroje.cz" data-event="email_click">info@amp-stroje.cz</a>
        </p>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .contact-grid {
    align-items: start;
  }
  .contact-info h2 {
    font-size: var(--text-h3);
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
  }
  .contact-info h2:first-child {
    margin-top: 0;
  }
  .contact-info address {
    font-style: normal;
    color: var(--color-ink-soft);
  }
  .contact-info a {
    color: var(--color-accent);
    text-decoration: none;
  }
  .placeholder-note {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--color-accent-dark);
  }
  .contact-person {
    display: flex;
    gap: var(--space-3);
    align-items: center;
  }
  .contact-person__photo {
    width: 4rem;
    height: 4rem;
    min-height: 0;
    flex-shrink: 0;
    font-size: 10px;
    padding: var(--space-1);
    border-radius: 50%;
  }
  .contact-person__name {
    font-weight: var(--weight-semibold);
    font-family: var(--font-display);
    margin: 0;
  }
</style>
