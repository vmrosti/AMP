---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import Section from "../../components/Section.astro";
import TechnologyCard from "../../components/TechnologyCard.astro";
import CaseStudyCard from "../../components/CaseStudyCard.astro";
import FAQ from "../../components/FAQ.astro";
import CTA from "../../components/CTA.astro";
import AutomationCheck from "../../components/AutomationCheck.astro";
import { services } from "../../data/services.js";
import { getRelatedByService } from "../../data/caseStudies.js";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

const faqItems = [
  {
    question: "Jak dlouho trvá, než dostaneme první odpověď?",
    answer:
      "Ozveme se co nejdříve s reálným odhadem, ne obecnou nabídkou — obvykle v řádu pracovních dnů.",
  },
  {
    question: "Musíme mít hotovou technickou specifikaci?",
    answer:
      "Ne. Stačí popsat problém a kontext provozu — specifikaci si upřesníme společně v rámci konzultace nebo studie proveditelnosti.",
  },
  {
    question: "Berete i menší nebo netypické zakázky?",
    answer:
      "Ano — je to jedna z oblastí, kde má menší tým výhodu oproti velkým dodavatelům.",
  },
];

const related = getRelatedByService(service.slug);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Domů", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Řešení", item: new URL("/reseni/", Astro.site).toString() },
    { "@type": "ListItem", position: 3, name: service.title, item: new URL(Astro.url.pathname, Astro.site).toString() },
  ],
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  description: service.seo.description,
  provider: {
    "@type": "LocalBusiness",
    name: "AMP-stroje, s.r.o.",
  },
  areaServed: "CZ",
};
---

<BaseLayout
  title={service.seo.title}
  description={service.seo.description}
  schema={[breadcrumbSchema, serviceSchema]}
>
  <nav class="breadcrumbs container" aria-label="Drobečková navigace">
    <a href="/">Domů</a> / <a href="/reseni/">Řešení</a> / <span>{service.title}</span>
  </nav>

  <Hero
    headline={service.title}
    subheadline={service.reseni}
    ctaLabel={service.cta}
    size="small"
  />

  <Section>
    <div class="grid grid--2 service-detail">
      <div class="reveal">
        <h2 class="service-detail__heading">Co řeší</h2>
        <p>{service.co_resi}</p>
      </div>
      <div class="reveal" style="--reveal-index:1">
        <h2 class="service-detail__heading">Pro koho</h2>
        <p>{service.pro_koho}</p>
      </div>
      <div class="reveal" style="--reveal-index:2">
        <h2 class="service-detail__heading">Jak pracujeme</h2>
        <p>{service.jak_pracujeme}</p>
      </div>
      <div class="reveal" style="--reveal-index:3">
        <h2 class="service-detail__heading">Výsledek</h2>
        <p>{service.vysledek}</p>
      </div>
    </div>
  </Section>

  {service.technologie && (
    <Section variant="alt" eyebrow="Technologie" title="Co při tom používáme">
      <div class="grid grid--3">
        <TechnologyCard label="Technologie" value={service.technologie} />
      </div>
    </Section>
  )}

  {related.length > 0 && (
    <Section eyebrow="Realizace" title="Ukázka z praxe">
      <div class="grid grid--2">
        {related.map((c) => (
          <CaseStudyCard href={`/realizace/${c.slug}/`} title={c.title} obor={c.industry} />
        ))}
      </div>
    </Section>
  )}

  {service.slug === "studie-proveditelnosti" && (
    <Section
      eyebrow="Automation Check"
      title="Zkuste rychlý orientační test"
      subtitle="Než objednáte studii proveditelnosti, zjistěte zdarma, jestli má váš proces vůbec smysl posuzovat."
    >
      <AutomationCheck />
    </Section>
  )}

  <Section variant="alt" eyebrow="Časté otázky" title="Co se nás ptáte nejčastěji">
    <FAQ items={faqItems} />
  </Section>

  <CTA title={service.cta} ctaLabel="Proberme váš projekt" />
</BaseLayout>

<style>
  .breadcrumbs {
    padding-top: var(--space-4);
    font-size: var(--text-small);
    color: var(--color-steel);
  }
  .breadcrumbs a {
    color: var(--color-steel);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    text-decoration: underline;
  }
  .service-detail {
    gap: var(--space-6);
  }
  .service-detail__heading {
    font-size: var(--text-h3);
    margin-bottom: var(--space-2);
  }
  .service-detail p {
    color: var(--color-ink-soft);
  }
</style>
