---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import Section from "../../components/Section.astro";
import GalleryLightbox from "../../components/GalleryLightbox.astro";
import CTA from "../../components/CTA.astro";
import { getPublished } from "../../data/caseStudies.js";
import { services } from "../../data/services.js";

const publishedCaseStudies = getPublished();

// Dokud nejsou publikované žádné reálné realizace s fotkami, galerie zobrazuje
// jasně označené placeholdery kategorizované podle skutečné nabídky služeb —
// ne vymyšlené projekty. Jakmile přibudou reálné fotky, nahradí se `image`.
const galleryItems =
  publishedCaseStudies.length > 0
    ? publishedCaseStudies.flatMap((c) =>
        (c.fotografie.length > 0 ? c.fotografie : [{ src: null, alt: c.title }]).map((f) => ({
          title: c.title,
          category: c.industry,
          image: f.src,
          alt: f.alt,
        }))
      )
    : services.map((s) => ({
        title: s.title,
        category: `Služba ${s.number}`,
        image: null,
      }));
---
<BaseLayout
  title="Realizace | AMP-stroje"
  description="Přehled strojů, konstrukcí a automatizovaných pracovišť, které jsme navrhli, vyrobili nebo opravili."
>
  <Hero headline="Co jsme postavili" size="small" />

  <Section>
    <GalleryLightbox items={galleryItems} />
    {publishedCaseStudies.length === 0 && (
      <p class="empty-note reveal">
        Fotografie konkrétních realizací zatím připravujeme — dlaždice výše
        ukazují, jak bude galerie vypadat. Mezitím se podívejte na
        <a href="/sluzby/">naše služby</a> nebo nám
        <a href="/kontakt/">rovnou popište váš projekt</a>.
      </p>
    )}
  </Section>

  {publishedCaseStudies.length > 0 && (
    <Section variant="soft" eyebrow="Detail" title="Case studies">
      <div class="grid grid--3">
        {publishedCaseStudies.map((c) => (
          <a href={`/realizace/${c.slug}/`} class="cs-link reveal">{c.title} →</a>
        ))}
      </div>
    </Section>
  )}

  <CTA
    title="Řešíte podobný problém?"
    subtitle="Popište nám ho — podíváme se, jestli se dá vyřešit podobně jednoduše."
    ctaLabel="Proberme váš projekt"
  />
</BaseLayout>

<style>
  .empty-note {
    max-width: 40rem;
    margin-top: var(--space-5);
    color: var(--color-steel);
  }
  .empty-note a {
    color: var(--color-accent-bright);
  }
  .cs-link {
    color: var(--color-paper);
    text-decoration: none;
    font-weight: var(--weight-medium);
  }
</style>
