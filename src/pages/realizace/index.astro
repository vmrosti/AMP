---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import Section from "../../components/Section.astro";
import CaseStudyCard from "../../components/CaseStudyCard.astro";
import CTA from "../../components/CTA.astro";
import { getPublished } from "../../data/caseStudies.js";

const publishedCaseStudies = getPublished();
---
<BaseLayout
  title="Realizace | AMP-stroje"
  description="Přehled strojů a automatizovaných pracovišť, které jsme navrhli a postavili."
>
  <Hero headline="Co jsme postavili" size="small" />
  <Section>
    {publishedCaseStudies.length > 0 ? (
      <div class="grid grid--3">
        {publishedCaseStudies.map((c) => (
          <CaseStudyCard href={`/realizace/${c.slug}/`} title={c.title} obor={c.industry} />
        ))}
      </div>
    ) : (
      <p class="empty-note">
        Realizace zatím připravujeme ke zveřejnění — první case studies přibudou
        v nejbližší době. Mezitím se podívejte na <a href="/reseni/">naše řešení</a>
        nebo nám <a href="/kontakt/">rovnou popište váš projekt</a>.
      </p>
    )}
  </Section>
  <CTA
    title="Řešíte podobný problém?"
    subtitle="Popište nám ho — podíváme se, jestli se dá vyřešit podobně jednoduše."
    ctaLabel="Proberme váš projekt"
  />
</BaseLayout>

<style>
  .empty-note {
    max-width: 40rem;
    color: var(--color-ink-soft);
  }
  .empty-note a {
    color: var(--color-accent);
  }
</style>
