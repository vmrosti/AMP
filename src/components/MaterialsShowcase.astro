---
interface Material {
  name: string;
  detail: string;
  color: string;
}
interface Props {
  materials: Material[];
}
const { materials } = Astro.props;
---

<div class="materials">
  {materials.map((m, i) => (
    <div class="materials__swatch reveal" style={`--reveal-index:${i}; --swatch-color:${m.color}`}>
      <span class="materials__color" aria-hidden="true"></span>
      <span class="materials__name">{m.name}</span>
      <span class="materials__detail">{m.detail}</span>
    </div>
  ))}
</div>

<style>
  .materials {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .materials {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .materials__swatch {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    background: var(--color-white);
    border: 1px solid var(--color-steel-light-on-paper);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .materials__swatch::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: var(--swatch-color);
  }

  .materials__swatch:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }

  .materials__color {
    display: inline-block;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--swatch-color);
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.15), 0 4px 10px color-mix(in srgb, var(--swatch-color) 40%, transparent);
  }

  .materials__name {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: var(--text-body);
    color: var(--color-ink);
  }

  .materials__detail {
    font-size: var(--text-small);
    color: var(--color-ink-soft);
  }
</style>
