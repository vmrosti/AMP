---
// Animovaný technický diagram signálového toku jednoúčelového stroje —
// vizuální "podpis" stránky Automatizace, jinde na webu se neopakuje.
// Vlastní SVG grafika (žádný copyright problém), pulzující signál mezi
// třemi uzly ilustruje princip řízení (senzor -> PLC -> akční člen).
---

<div class="auto-diagram" data-auto-diagram>
  <svg viewBox="0 0 800 260" fill="none" class="auto-diagram__svg" role="img" aria-label="Schéma signálového toku: senzor, řídicí jednotka, akční člen">
    <defs>
      <linearGradient id="nodeGrad" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#0E7A1D" />
        <stop offset="1" stop-color="#0A5A15" />
      </linearGradient>
    </defs>

    <!-- pozadí technický rastr -->
    <g opacity="0.15" stroke="#F5F4F1" stroke-width="1">
      <line x1="0" y1="65" x2="800" y2="65" />
      <line x1="0" y1="130" x2="800" y2="130" />
      <line x1="0" y1="195" x2="800" y2="195" />
    </g>

    <!-- spojnice -->
    <path d="M150 130 H340" stroke="#3A3F33" stroke-width="2" />
    <path d="M460 130 H650" stroke="#3A3F33" stroke-width="2" />

    <!-- putující signál -->
    <circle r="5" fill="#00D319" filter="url(#glow)" class="auto-diagram__pulse">
      <animateMotion dur="2.8s" repeatCount="indefinite" path="M150 130 H340" />
    </circle>
    <circle r="5" fill="#00D319" filter="url(#glow)" class="auto-diagram__pulse" style="animation-delay:1.4s">
      <animateMotion dur="2.8s" begin="1.4s" repeatCount="indefinite" path="M460 130 H650" />
    </circle>

    <filter id="glow" x="-100%" y="-100%" width="300%" height="300%">
      <feGaussianBlur stdDeviation="3" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <!-- Uzel 1: Senzor -->
    <g transform="translate(150,130)">
      <circle r="55" fill="url(#nodeGrad)" />
      <circle r="55" fill="none" stroke="#00D319" stroke-width="1.5" opacity="0.5" class="auto-diagram__ring" />
      <path d="M-16 8 a16 16 0 1 1 32 0 M-16 8 h32 M0 -8 v-10" stroke="#F5F4F1" stroke-width="2.2" fill="none" stroke-linecap="round" />
    </g>
    <text x="150" y="210" text-anchor="middle" class="auto-diagram__label">SENZOR</text>
    <text x="150" y="230" text-anchor="middle" class="auto-diagram__sublabel">detekce polohy / dílu</text>

    <!-- Uzel 2: Řídicí jednotka -->
    <g transform="translate(400,130)">
      <circle r="65" fill="url(#nodeGrad)" />
      <circle r="65" fill="none" stroke="#00D319" stroke-width="1.5" opacity="0.5" class="auto-diagram__ring" style="animation-delay:0.5s" />
      <rect x="-20" y="-20" width="40" height="40" rx="4" fill="none" stroke="#F5F4F1" stroke-width="2.2" />
      <circle cx="0" cy="0" r="6" fill="#F5F4F1" />
    </g>
    <text x="400" y="220" text-anchor="middle" class="auto-diagram__label">ŘÍDICÍ JEDNOTKA</text>
    <text x="400" y="240" text-anchor="middle" class="auto-diagram__sublabel">PLC logika, bezpečnost</text>

    <!-- Uzel 3: Akční člen -->
    <g transform="translate(650,130)">
      <circle r="55" fill="url(#nodeGrad)" />
      <circle r="55" fill="none" stroke="#00D319" stroke-width="1.5" opacity="0.5" class="auto-diagram__ring" style="animation-delay:1s" />
      <path d="M-14 12 l14 -24 l14 24 z" fill="none" stroke="#F5F4F1" stroke-width="2.2" stroke-linejoin="round" />
      <line x1="0" y1="12" x2="0" y2="20" stroke="#F5F4F1" stroke-width="2.2" />
    </g>
    <text x="650" y="210" text-anchor="middle" class="auto-diagram__label">AKČNÍ ČLEN</text>
    <text x="650" y="230" text-anchor="middle" class="auto-diagram__sublabel">pohon, chapadlo, ventil</text>

    <!-- dopravníkový pás s pohybujícím se dílem dole -->
    <rect x="40" y="245" width="720" height="6" rx="3" fill="#2a2d24" />
    <rect x="40" y="245" width="720" height="2" fill="#3A3F33" />
    <g class="auto-diagram__part">
      <rect x="-16" y="-32" width="32" height="26" rx="3" fill="#8B96A0" />
      <rect x="-16" y="-32" width="32" height="6" fill="#F5F4F1" opacity="0.4" />
    </g>
  </svg>
</div>

<style>
  .auto-diagram {
    background: linear-gradient(155deg, var(--color-void) 0%, var(--color-void-soft) 60%, #0f2913 100%);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    box-shadow: var(--shadow-elevated);
  }

  .auto-diagram__svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .auto-diagram__label {
    fill: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .auto-diagram__sublabel {
    fill: var(--color-steel);
    font-family: var(--font-body);
    font-size: 11px;
  }

  .auto-diagram__ring {
    transform-box: fill-box;
    transform-origin: center;
    animation: ring-pulse 2.4s ease-out infinite;
  }

  @keyframes ring-pulse {
    0% { transform: scale(1); opacity: 0.6; }
    100% { transform: scale(1.35); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .auto-diagram__ring,
    .auto-diagram__pulse,
    .auto-diagram__part {
      animation: none;
      display: none;
    }
  }

  .auto-diagram__part {
    animation: part-travel 5.6s linear infinite;
  }

  @keyframes part-travel {
    0% { transform: translate(60px, 251px); }
    100% { transform: translate(740px, 251px); }
  }
</style>
