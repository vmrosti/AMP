---
// POZNÁMKA: komponenta je připravena podle požadovaného seznamu komponent, ale podle
// schváleného návrhu (interaktivní prvky, sekce 6-7) je "kalkulátor" ve fázi 1
// zamítnutý — bez reálných vstupních dat AMP by byl nedůvěryhodný. Komponenta proto
// NENÍ zapojená do žádné stránky. Až budou k dispozici reálná vstupní data (např.
// orientační parametry pro odhad návratnosti automatizace), lze ji dopracovat a
// zapojit do fáze 2. Čistý vanilla JS, žádná externí služba.
interface Field {
  id: string;
  label: string;
  unit?: string;
}
interface Props {
  title: string;
  fields: Field[];
}
const { title, fields } = Astro.props;
---

<div class="calculator" data-calculator>
  <h3 class="calculator__title">{title}</h3>
  <form class="calculator__form">
    {
      fields.map((f) => (
        <div class="calculator__field">
          <label for={f.id}>{f.label}</label>
          <div class="calculator__input-wrap">
            <input type="number" id={f.id} name={f.id} min="0" step="any" />
            {f.unit && <span>{f.unit}</span>}
          </div>
        </div>
      ))
    }
  </form>
  <p class="calculator__note">
    [DOPLNIT — vzorec výpočtu musí dodat AMP na základě reálných provozních dat, jinak
    by výsledek byl zavádějící]
  </p>
</div>

<style>
  .calculator {
    padding: var(--space-4);
    border: 1px dashed var(--color-steel-light);
    border-radius: var(--radius-md);
  }
  .calculator__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .calculator__input-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .calculator__note {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--color-accent-dark);
  }
</style>
