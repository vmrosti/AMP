---
import { services } from "../data/services.js";
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <p class="footer__logo">AMP-stroje</p>
      <p class="footer__tag">V jednoduchosti je síla.</p>
    </div>

    <nav aria-label="Navigace">
      <h2 class="footer__heading">Navigace</h2>
      <ul>
        <li><a href="/reseni/">Řešení</a></li>
        <li><a href="/realizace/">Realizace</a></li>
        <li><a href="/o-nas/">O nás</a></li>
        <li><a href="/kontakt/">Kontakt</a></li>
        <li><a href="/ochrana-osobnich-udaju/">Ochrana osobních údajů</a></li>
      </ul>
    </nav>

    <nav aria-label="Řešení">
      <h2 class="footer__heading">Řešení</h2>
      <ul>
        {services.map((s) => <li><a href={`/reseni/${s.slug}/`}>{s.title}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="footer__heading">Kontakt</h2>
      <address>
        AMP-stroje, s.r.o.<br />
        Pražákova 1008/69<br />
        Brno, 639 00<br />
        IČO: 19091842<br />
        <a href="tel:+420777911077" data-event="phone_click">+420 777 911 077</a><br />
        <a href="mailto:info@amp-stroje.cz" data-event="email_click">info@amp-stroje.cz</a>
      </address>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>&copy; {new Date().getFullYear()} AMP-stroje, s.r.o.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-ink);
    color: var(--color-steel-light);
    padding-block: var(--space-7) var(--space-5);
  }

  @media (max-width: 1023px) {
    .footer {
      padding-bottom: calc(var(--space-5) + 4.5rem); /* místo pro sticky mobilní CTA */
    }
  }

  .footer__grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: 1.5fr 1fr 1fr 1.5fr;
    }
  }

  .footer__logo {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: var(--text-h3);
    color: var(--color-white);
    margin: 0 0 var(--space-2);
  }

  .footer__tag {
    color: var(--color-steel-light);
    font-size: var(--text-small);
    margin: 0;
  }

  .footer__heading {
    font-size: var(--text-small);
    font-family: var(--font-mono);
    color: var(--color-steel-light);
    margin-bottom: var(--space-3);
  }

  .footer ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer a {
    color: var(--color-paper-alt);
    text-decoration: none;
    font-size: var(--text-small);
  }

  .footer a:hover {
    color: var(--color-white);
    text-decoration: underline;
  }

  address {
    font-style: normal;
    font-size: var(--text-small);
    line-height: var(--leading-normal);
  }

  .footer__bottom {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: var(--text-small);
  }

  .footer__bottom p {
    margin: 0;
  }
</style>
