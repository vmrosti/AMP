---
// Cookie lišta — web dnes nepoužívá žádné cookies třetích stran (žádná
// analytika není zapnutá, viz analytics.js). I tak nabízí skutečnou volbu
// Přijmout/Odmítnout (ne jen "Rozumím") — obě uloží jasnou hodnotu do
// localStorage (`cookie-consent` = "accepted" / "rejected"), kterou bude
// moct budoucí analytika přečíst, než se rozhodne cokoliv načíst.
---

<div class="cookie-bar" id="cookie-bar" role="dialog" aria-label="Souhlas s cookies">
  <div class="cookie-bar__inner container">
    <p>
      Tento web dnes nepoužívá žádné sledovací ani marketingové cookies —
      jen technicky nezbytná data pro fungování formuláře. Pokud v budoucnu
      přidáme analytiku, spustí se až po vašem souhlasu zde.
      <a href="/ochrana-osobnich-udaju/">Více v zásadách zpracování osobních údajů</a>.
    </p>
    <div class="cookie-bar__actions">
      <button type="button" class="btn btn--secondary" id="cookie-bar-reject">
        Odmítnout
      </button>
      <button type="button" class="btn btn--primary" id="cookie-bar-accept">
        Přijmout
      </button>
    </div>
  </div>
</div>

<style>
  .cookie-bar {
    display: none;
    position: fixed;
    left: var(--space-3);
    right: var(--space-3);
    bottom: var(--space-3);
    z-index: var(--z-modal);
    max-width: 40rem;
    margin-inline: auto;
    background: var(--color-ink);
    color: var(--color-paper);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-elevated);
  }

  .cookie-bar.is-visible {
    display: block;
  }

  .cookie-bar__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    max-width: none;
  }

  @media (min-width: 640px) {
    .cookie-bar__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-5);
    }
  }

  .cookie-bar p {
    font-size: var(--text-small);
    color: var(--color-steel);
    margin: 0;
  }

  .cookie-bar a {
    color: var(--color-accent-bright);
  }

  .cookie-bar__actions {
    display: flex;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .cookie-bar__actions .btn {
    padding: 10px 18px;
  }

  #cookie-bar-reject {
    color: var(--color-paper);
    border-color: var(--color-steel-light);
  }
</style>

<script>
  const KEY = "cookie-consent";
  const bar = document.getElementById("cookie-bar");
  const acceptBtn = document.getElementById("cookie-bar-accept");
  const rejectBtn = document.getElementById("cookie-bar-reject");

  function setConsent(value: "accepted" | "rejected") {
    bar?.classList.remove("is-visible");
    try {
      localStorage.setItem(KEY, value);
    } catch {
      /* localStorage nedostupné — lišta se prostě zavře, nic se nerozbije */
    }
  }

  try {
    if (!localStorage.getItem(KEY) && bar) {
      bar.classList.add("is-visible");
    }
  } catch {
    // localStorage nedostupné (soukromý režim apod.) — lištu radši nezobrazovat.
  }

  acceptBtn?.addEventListener("click", () => setConsent("accepted"));
  rejectBtn?.addEventListener("click", () => setConsent("rejected"));
</script>
