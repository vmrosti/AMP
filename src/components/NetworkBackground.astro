---
// Jemná animovaná síť bodů a čar na pozadí — vlastní grafika (žádný copyright
// problém), inspirovaná obvodovými stopami z loga. Canvas s malým počtem uzlů,
// nízká náročnost na CPU/GPU, automaticky se zastaví na prefers-reduced-motion
// a když karta není ve viewportu (IntersectionObserver), aby nezatěžovala
// baterii na mobilu, když uživatel scrolluje pryč.
interface Props {
  density?: "low" | "medium";
}
const { density = "medium" } = Astro.props;
---

<canvas class="network-bg" data-network-bg data-density={density} aria-hidden="true"></canvas>

<style>
  .network-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  const canvases = document.querySelectorAll<HTMLCanvasElement>("[data-network-bg]");

  canvases.forEach((canvas) => {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const density = canvas.dataset.density === "low" ? 70 : 45; // px per node (menší = víc uzlů)

    let width = 0;
    let height = 0;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    let nodes: { x: number; y: number; vx: number; vy: number }[] = [];
    let animId: number | null = null;
    let running = false;

    // Barvy čteme z CSS proměnných, aby síť ladila se schváleným design systémem.
    const styles = getComputedStyle(document.documentElement);
    const lineColor = "20, 40, 25"; // tlumená zelenošedá, funguje na světlém pozadí
    const nodeColor = styles.getPropertyValue("--color-accent").trim() || "#0e7a1d";

    function resize() {
      const rect = canvas.parentElement?.getBoundingClientRect();
      width = rect?.width || canvas.clientWidth;
      height = rect?.height || canvas.clientHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      const count = Math.max(14, Math.round((width * height) / (density * density * 130)));
      nodes = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.5,
        vy: (Math.random() - 0.5) * 0.5,
      }));
    }

    function step() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      for (const n of nodes) {
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < 0 || n.x > width) n.vx *= -1;
        if (n.y < 0 || n.y > height) n.vy *= -1;
      }

      const maxDist = Math.max(width, height) / 5.5;
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < maxDist) {
            const opacity = (1 - dist / maxDist) * 0.35;
            ctx.strokeStyle = `rgba(${lineColor}, ${opacity})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            ctx.stroke();
          }
        }
      }

      for (const n of nodes) {
        ctx.beginPath();
        ctx.arc(n.x, n.y, 1.8, 0, Math.PI * 2);
        ctx.fillStyle = nodeColor;
        ctx.globalAlpha = 0.55;
        ctx.fill();
        ctx.globalAlpha = 1;
      }

      if (running) animId = requestAnimationFrame(step);
    }

    function start() {
      if (running) return;
      running = true;
      animId = requestAnimationFrame(step);
    }
    function stop() {
      running = false;
      if (animId) cancelAnimationFrame(animId);
    }

    resize();
    window.addEventListener("resize", resize, { passive: true });

    if (prefersReduced) {
      // Statický snímek sítě místo animace — pořád vizuálně bohaté, bez pohybu.
      step();
    } else {
      // Běží jen, když je canvas skutečně ve viewportu (šetří baterii/CPU).
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => (e.isIntersecting ? start() : stop())),
        { threshold: 0.05 }
      );
      io.observe(canvas);
    }
  });
</script>
