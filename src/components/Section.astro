---
interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  variant?: "default" | "alt" | "dark";
  id?: string;
}
const { eyebrow, title, subtitle, variant = "default", id } = Astro.props;
---

<section
  class:list={["section", variant === "alt" && "section--alt", variant === "dark" && "section--dark"]}
  id={id}
>
  <div class="container">
    {
      (eyebrow || title || subtitle) && (
        <div class="section__head reveal">
          {eyebrow && <span class="section__eyebrow">{eyebrow}</span>}
          {title && <h2 class="section__title">{title}</h2>}
          {subtitle && <p class="section__subtitle">{subtitle}</p>}
        </div>
      )
    }
    <slot />
  </div>
</section>
