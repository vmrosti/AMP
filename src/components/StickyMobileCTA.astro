---
// Sticky mobilní CTA lišta. Zobrazí se až po scrollu (ne hned při načtení, aby
// nezakrývala hero), jen na mobilu (desktop má CTA v headeru). Skryje se na
// stránce /kontakt/, kde by byla duplicitní.
const isContactPage = Astro.url.pathname.startsWith("/kontakt");
---

{
  !isContactPage && (
    <div class="sticky-cta" id="sticky-cta" data-sticky-cta>
      <a href="/kontakt/" class="sticky-cta__link">
        <span>Popište nám problém</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </a>
    </div>
  )
}

<style>
  .sticky-cta {
    position: fixed;
    left: var(--space-3);
    right: var(--space-3);
    bottom: calc(var(--space-3) + env(safe-area-inset-bottom, 0px));
    z-index: var(--z-header);
    transform: translateY(120%);
    opacity: 0;
    transition: transform var(--transition-base), opacity var(--transition-base);
    pointer-events: none;
  }

  .sticky-cta.is-visible {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .sticky-cta__link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    background: var(--color-accent);
    color: var(--color-white);
    text-decoration: none;
    font-weight: var(--weight-medium);
    padding: 14px var(--space-4);
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 16px rgba(20, 22, 26, 0.25);
  }

  @media (min-width: 1024px) {
    .sticky-cta {
      display: none; /* na desktopu je CTA v headeru */
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-cta {
      transition: none;
    }
  }
</style>

<script>
  const el = document.getElementById("sticky-cta");
  if (el) {
    let ticking = false;
    const update = () => {
      const shouldShow = window.scrollY > window.innerHeight * 0.6;
      el.classList.toggle("is-visible", shouldShow);
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );
    update();
  }
</script>
