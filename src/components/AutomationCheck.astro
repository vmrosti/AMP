---
// „Má váš proces potenciál pro automatizaci?“ — orientační nástroj, ne kalkulačka ROI.
// Čistý HTML/JS, žádný externí výpočet ani API. Výsledek je vždy kvalitativní
// (nízký/střední/vysoký potenciál) s vysvětlením, nikdy konkrétní číslo návratnosti.
---

<div class="ac" data-automation-check>
  <form class="ac__form" id="ac-form">
    <fieldset class="ac__question">
      <legend>Kolik kusů měsíčně tato operace zpracovává?</legend>
      <label><input type="radio" name="objem" value="0" required /> Do 1 000 ks</label>
      <label><input type="radio" name="objem" value="1" /> 1 000–10 000 ks</label>
      <label><input type="radio" name="objem" value="2" /> Nad 10 000 ks</label>
    </fieldset>

    <fieldset class="ac__question">
      <legend>Na kolik směn provoz jede?</legend>
      <label><input type="radio" name="smeny" value="0" required /> 1 směna</label>
      <label><input type="radio" name="smeny" value="1" /> 2 směny</label>
      <label><input type="radio" name="smeny" value="2" /> 3 směny / nepřetržitě</label>
    </fieldset>

    <fieldset class="ac__question">
      <legend>Kolik lidí dnes operaci obsluhuje?</legend>
      <label><input type="radio" name="lide" value="0" required /> 1 osoba</label>
      <label><input type="radio" name="lide" value="1" /> 2–3 osoby</label>
      <label><input type="radio" name="lide" value="2" /> 4 a více</label>
    </fieldset>

    <fieldset class="ac__question">
      <legend>Je operace opakující se, se stejným postupem pokaždé?</legend>
      <label><input type="radio" name="opakovani" value="2" required /> Ano</label>
      <label><input type="radio" name="opakovani" value="0" /> Ne, hodně se liší kus od kusu</label>
    </fieldset>

    <fieldset class="ac__question">
      <legend>Je potřeba vizuální nebo rozměrová kontrola výsledku?</legend>
      <label><input type="radio" name="kontrola" value="1" required /> Ano</label>
      <label><input type="radio" name="kontrola" value="0" /> Ne</label>
    </fieldset>

    <fieldset class="ac__question">
      <legend>Mění se často díl nebo postup (nová varianta, nový model)?</legend>
      <label><input type="radio" name="stabilita" value="0" required /> Často</label>
      <label><input type="radio" name="stabilita" value="2" /> Zřídka, proces je stabilní</label>
    </fieldset>

    <button type="submit" class="btn btn--primary">Zjistit potenciál</button>
  </form>

  <div class="ac__result" id="ac-result" hidden role="status" aria-live="polite">
    <p class="ac__result-label" id="ac-result-label"></p>
    <ul class="ac__result-reasons" id="ac-result-reasons"></ul>
    <p class="ac__disclaimer">
      Toto je orientační odhad na základě vašich odpovědí, ne přesný výpočet
      návratnosti. Reálný potenciál a návratnost investice ukáže až studie
      proveditelnosti na míru vašemu provozu.
    </p>
    <a href="/kontakt/?zprava=Chtěl%20bych%20probrat%20výsledek%20Automation%20Checku." class="btn btn--secondary">
      Chcete výsledek probrat s AMP?
    </a>
  </div>
</div>

<style>
  .ac__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 36rem;
  }

  .ac__question {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .ac__question legend {
    font-family: var(--font-display);
    font-weight: var(--weight-medium);
    font-size: var(--text-body-lg);
    margin-bottom: var(--space-2);
    padding: 0;
  }

  .ac__question label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-body);
    color: var(--color-ink-soft);
    padding: 10px 12px;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .ac__question label:has(input:checked) {
    border-color: var(--color-accent);
    background: rgba(184, 72, 31, 0.06);
    color: var(--color-ink);
  }

  .ac__question input {
    accent-color: var(--color-accent);
  }

  .ac__result {
    margin-top: var(--space-6);
    padding: var(--space-5);
    background: var(--color-white);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    max-width: 36rem;
  }

  .ac__result-label {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-3);
  }

  .ac__result-label[data-level="nizky"] {
    color: var(--color-steel);
  }
  .ac__result-label[data-level="stredni"] {
    color: var(--color-accent-dark);
  }
  .ac__result-label[data-level="vysoky"] {
    color: var(--color-success);
  }

  .ac__result-reasons {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .ac__result-reasons li {
    padding-left: var(--space-3);
    border-left: 2px solid var(--color-steel-light);
    color: var(--color-ink-soft);
    font-size: var(--text-small);
  }

  .ac__disclaimer {
    font-size: var(--text-small);
    color: var(--color-steel);
    margin-bottom: var(--space-4);
  }
</style>

<script>
  const form = document.getElementById("ac-form") as HTMLFormElement | null;
  let startTracked = false;
  form?.addEventListener(
    "change",
    () => {
      if (!startTracked) {
        startTracked = true;
        window.trackEvent?.("automation_check_start");
      }
    },
    { once: false }
  );
  const result = document.getElementById("ac-result");
  const label = document.getElementById("ac-result-label");
  const reasonsEl = document.getElementById("ac-result-reasons");

  const reasonText: Record<string, { positive: string; negative: string }> = {
    objem: {
      positive: "Vyšší objem výroby zlepšuje návratnost investice do automatizace.",
      negative: "Nízký objem znamená delší návratnost investice do stroje.",
    },
    smeny: {
      positive: "Vícesměnný provoz využije stroj efektivněji a rychleji se vrátí.",
      negative: "Jednosměnný provoz prodlužuje dobu návratnosti.",
    },
    lide: {
      positive: "Operaci dnes obsluhuje víc lidí — automatizace uvolní kapacitu pro jinou práci.",
      negative: "Operaci obsluhuje jen jeden člověk — úspora kapacity bude menší.",
    },
    opakovani: {
      positive: "Opakující se postup je pro automatizaci ideální.",
      negative: "Velká variabilita mezi kusy automatizaci komplikuje a prodražuje.",
    },
    kontrola: {
      positive: "Potřeba kontroly jde často vyřešit společně s automatizací (kamerový systém).",
      negative: "Bez nutnosti kontroly bude řešení jednodušší, ale to nesnižuje jeho hodnotu.",
    },
    stabilita: {
      positive: "Stabilní proces bez častých změn je pro jednoúčelový stroj vhodný.",
      negative: "Časté změny dílu nebo postupu snižují návratnost pevně nastaveného stroje.",
    },
  };

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    let score = 0;
    const reasons: string[] = [];

    for (const [name, info] of Object.entries(reasonText)) {
      const raw = data.get(name);
      if (raw === null) continue;
      const value = Number(raw);
      score += value;
      reasons.push(value > 0 ? info.positive : info.negative);
    }

    let level: "nizky" | "stredni" | "vysoky";
    let levelText: string;
    if (score <= 4) {
      level = "nizky";
      levelText = "Nízký potenciál";
    } else if (score <= 8) {
      level = "stredni";
      levelText = "Střední potenciál";
    } else {
      level = "vysoky";
      levelText = "Vysoký potenciál";
    }

    if (label) {
      label.textContent = levelText;
      label.dataset.level = level;
    }
    if (reasonsEl) {
      reasonsEl.innerHTML = "";
      reasons.forEach((r) => {
        const li = document.createElement("li");
        li.textContent = r;
        reasonsEl.appendChild(li);
      });
    }
    if (result) {
      result.hidden = false;
      result.scrollIntoView({ behavior: "smooth", block: "nearest" });
      window.trackEvent?.("automation_check_complete", { level });
    }
  });
</script>
