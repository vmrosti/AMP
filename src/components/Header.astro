---
const nav = [
  { href: "/sluzby/", label: "Služby" },
  { href: "/realizace/", label: "Realizace" },
  { href: "/o-nas/", label: "O nás" },
  { href: "/kontakt/", label: "Kontakt" },
];
const currentPath = Astro.url.pathname;
---

<header class="header" id="site-header">
  <div class="container header__row">
    <a href="/" class="header__logo" aria-label="AMP-stroje — domů">
      <img src="/images/logo-mark.png" alt="" class="header__logo-mark" width="36" height="20" />
      <span>AMP-stroje</span>
    </a>

    <nav class="header__nav" aria-label="Hlavní navigace">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={currentPath.startsWith(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/kontakt/" class="btn btn--primary header__cta">Popište nám problém</a>

    <button
      class="header__menu-toggle"
      id="menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only">Otevřít menu</span>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
      <li><a href="/kontakt/" class="btn btn--primary">Popište nám problém</a></li>
    </ul>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    height: var(--header-height);
    display: flex;
    align-items: center;
    background: transparent;
    transition: background-color var(--transition-base), border-color var(--transition-base),
      box-shadow var(--transition-base);
    border-bottom: 1px solid transparent;
  }

  .header.is-scrolled {
    background: rgba(10, 11, 13, 0.85);
    backdrop-filter: blur(12px);
    border-bottom-color: var(--color-steel-light);
  }

  .header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: var(--space-4);
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: 1.125rem;
    text-decoration: none;
    color: var(--color-paper);
  }

  .header__logo-mark {
    flex-shrink: 0;
    height: 1.4rem;
    width: auto;
  }

  .header__nav {
    display: none;
  }

  .header__nav ul {
    display: flex;
    gap: var(--space-5);
  }

  .header__nav a {
    text-decoration: none;
    font-size: var(--text-body);
    color: var(--color-steel);
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .header__nav a:hover,
  .header__nav a[aria-current="page"] {
    color: var(--color-paper);
    border-color: var(--color-accent);
  }

  .header__cta {
    display: none;
  }

  .header__menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--color-paper);
    padding: var(--space-2);
    margin-inline-start: auto;
  }

  @media (min-width: 1024px) {
    .header__nav {
      display: block;
    }
    .header__cta {
      display: inline-flex;
    }
    .header__menu-toggle {
      display: none;
    }
  }

  .mobile-menu {
    position: fixed;
    inset: var(--header-height) 0 0 0;
    background: var(--color-void);
    z-index: var(--z-overlay);
    overflow-y: auto;
  }

  .mobile-menu ul {
    display: flex;
    flex-direction: column;
    padding: var(--space-5) var(--container-padding);
    gap: var(--space-4);
  }

  .mobile-menu a {
    display: block;
    font-size: var(--text-h3);
    text-decoration: none;
    color: var(--color-paper);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  const onScroll = () => {
    if (!header) return;
    header.classList.toggle("is-scrolled", window.scrollY > 40);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const focusableSelector =
    'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';

  function openMenu() {
    toggle?.setAttribute("aria-expanded", "true");
    if (menu) menu.hidden = false;
    document.body.style.overflow = "hidden";
    // Focus přejde na první fokusovatelný prvek uvnitř menu.
    const first = menu?.querySelector<HTMLElement>(focusableSelector);
    first?.focus();
  }

  function closeMenu({ returnFocus = true } = {}) {
    const wasOpen = toggle?.getAttribute("aria-expanded") === "true";
    toggle?.setAttribute("aria-expanded", "false");
    if (menu) menu.hidden = true;
    document.body.style.overflow = "";
    if (wasOpen && returnFocus) toggle?.focus();
  }

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    if (isOpen) closeMenu();
    else openMenu();
  });

  // Zavřít mobilní menu při přechodu na kotvu/odkaz (focus se vrací na
  // hamburger jen když se nikam nenavigovalo — zde navigace probíhá, takže
  // focus návrat nedává smysl, jen zavřeme stav).
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => closeMenu({ returnFocus: false }))
  );

  // ESC zavře menu a vrátí focus na hamburger.
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      closeMenu();
    }
  });

  // Klik mimo otevřené menu ho zavře.
  document.addEventListener("click", (e) => {
    if (toggle?.getAttribute("aria-expanded") !== "true") return;
    const target = e.target as Node;
    if (menu && !menu.contains(target) && !toggle.contains(target)) {
      closeMenu({ returnFocus: false });
    }
  });

  // Focus trap: Tab/Shift+Tab cyklí jen mezi prvky uvnitř otevřeného menu.
  menu?.addEventListener("keydown", (e) => {
    if (e.key !== "Tab") return;
    const focusables = Array.from(menu.querySelectorAll<HTMLElement>(focusableSelector));
    if (focusables.length === 0) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    const active = document.activeElement;

    if (e.shiftKey && active === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && active === last) {
      e.preventDefault();
      first.focus();
    }
  });
</script>
