---
interface Step {
  title: string;
  body: string;
  icon: "inquiry" | "study" | "build" | "support";
}
interface Props {
  steps: Step[];
}
const { steps } = Astro.props;

const icons: Record<Step["icon"], string> = {
  inquiry: `<path d="M4 4h16v12H9l-5 4V4Z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/>`,
  study: `<circle cx="10" cy="10" r="6" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M14.5 14.5 20 20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>`,
  build: `<path d="M14.7 6.3 17.7 9.3 8 19H5v-3L14.7 6.3Z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/><path d="M13 8l3 3" stroke="currentColor" stroke-width="1.6"/>`,
  support: `<path d="M4 12a8 8 0 0 1 16 0" stroke="currentColor" stroke-width="1.6" fill="none"/><rect x="3" y="12" width="4" height="6" rx="1.5" stroke="currentColor" stroke-width="1.6" fill="none"/><rect x="17" y="12" width="4" height="6" rx="1.5" stroke="currentColor" stroke-width="1.6" fill="none"/>`,
};

// Střed každé bubliny jako % šířky řádku (4 stejné sloupce -> středy v 1/8,
// 3/8, 5/8, 7/8). Jedna souvislá čára přes celý řádek — spolehlivější než
// spojovat kroky jednotlivě (to se předtím špatně zarovnávalo).
const n = steps.length;
const centers = steps.map((_, i) => ((i + 0.5) / n) * 100);
const pathD = `M${centers[0]},2 L${centers[centers.length - 1]},2`;
---

<div class="process" data-process>
  <div class="process__bg" aria-hidden="true"></div>

  <svg class="process__connector" viewBox="0 0 100 4" preserveAspectRatio="none" aria-hidden="true">
    <path d={pathD} class="process__connector-track" vector-effect="non-scaling-stroke" />
    <path d={pathD} class="process__connector-line" vector-effect="non-scaling-stroke" />
    <circle r="1.4" class="process__connector-pulse">
      <animateMotion dur="2.6s" repeatCount="indefinite" path={pathD} />
    </circle>
  </svg>

  <ol class="process__steps">
    {
      steps.map((step, i) => (
        <li class="process__step reveal" style={`--reveal-index:${i}`}>
          <div class="process__icon-wrap">
            <span class="process__number">{String(i + 1).padStart(2, "0")}</span>
            <svg class="process__icon" width="26" height="26" viewBox="0 0 24 24" fill="none" set:html={icons[step.icon]} />
          </div>
          <h3 class="process__title">{step.title}</h3>
          <p class="process__body">{step.body}</p>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .process {
    position: relative;
  }

  .process__bg {
    position: absolute;
    inset: -10% -5%;
    background-image:
      linear-gradient(rgba(0, 211, 25, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 211, 25, 0.07) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse 70% 70% at 50% 40%, black, transparent 75%);
    pointer-events: none;
  }

  .process__steps {
    position: relative;
    display: grid;
    gap: var(--space-7);
    grid-template-columns: 1fr;
  }

  @media (min-width: 1024px) {
    .process__steps {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-5);
    }
  }

  .process__step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
  }

  @media (min-width: 1024px) {
    .process__step {
      align-items: center;
      text-align: center;
    }
  }

  .process__icon-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.75rem;
    height: 4.75rem;
    border-radius: 50%;
    background: linear-gradient(150deg, var(--color-accent), var(--color-accent-dark));
    box-shadow: 0 0 0 1px rgba(0, 211, 25, 0.3), 0 0 32px rgba(0, 211, 25, 0.35), 0 10px 24px rgba(0, 0, 0, 0.4);
    color: var(--color-white);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .process__step:hover .process__icon-wrap {
    transform: translateY(-4px) scale(1.08);
    box-shadow: 0 0 0 1px rgba(0, 211, 25, 0.5), 0 0 48px rgba(0, 211, 25, 0.55), 0 14px 30px rgba(0, 0, 0, 0.5);
  }

  .process__number {
    position: absolute;
    top: -6px;
    right: -6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--color-void);
    color: var(--color-accent-bright);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: var(--weight-semibold);
    box-shadow: 0 0 0 3px var(--color-void), 0 0 0 4px rgba(0, 211, 25, 0.4);
  }

  /* Jedna souvislá čára přes celý řádek bublin — jen na desktopu, kde jsou
     kroky vedle sebe ve 4 sloupcích. Pozice "top" musí odpovídat středu
     ikony (poloviny výšky .process__icon-wrap = 2.375rem). */
  .process__connector {
    display: none;
  }

  @media (min-width: 1024px) {
    .process__connector {
      display: block;
      position: absolute;
      top: 2.375rem;
      left: 0;
      width: 100%;
      height: 6px;
      overflow: visible;
      z-index: 0;
    }

    .process__connector-track {
      stroke: rgba(245, 244, 241, 0.14);
      stroke-width: 2;
      fill: none;
    }

    .process__connector-line {
      stroke: var(--color-accent-bright);
      stroke-width: 2;
      fill: none;
      stroke-dasharray: 100;
      stroke-dashoffset: 100;
      transition: stroke-dashoffset var(--transition-draw);
      filter: drop-shadow(0 0 4px rgba(0, 211, 25, 0.6));
    }

    .process.is-visible .process__connector-line {
      stroke-dashoffset: 0;
    }

    .process__connector-pulse {
      fill: var(--color-accent-bright);
      filter: drop-shadow(0 0 6px rgba(0, 211, 25, 0.9));
      opacity: 0;
    }

    .process.is-visible .process__connector-pulse {
      opacity: 1;
    }
  }

  .process__step,
  .process__icon-wrap {
    z-index: 1;
  }

  .process__title {
    font-size: var(--text-h3);
    color: var(--color-paper);
  }

  .process__body {
    color: var(--color-steel);
    font-size: var(--text-small);
    max-width: 26ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .process__connector-pulse {
      display: none;
    }
  }
</style>

<script>
  const processes = document.querySelectorAll<HTMLElement>("[data-process]");
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 }
    );
    processes.forEach((el) => io.observe(el));
  } else {
    processes.forEach((el) => el.classList.add("is-visible"));
  }
</script>
