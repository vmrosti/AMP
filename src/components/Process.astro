---
interface Step {
  title: string;
  body: string;
}
interface Props {
  steps: Step[];
}
const { steps } = Astro.props;
---

<div class="process" data-process>
  <svg
    class="process__line"
    viewBox="0 0 1000 4"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <line x1="0" y1="2" x2="1000" y2="2" class="process__line-path" />
  </svg>

  <ol class="process__steps">
    {
      steps.map((step, i) => (
        <li class="process__step reveal" style={`--reveal-index:${i}`}>
          <span class="process__number">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="process__title">{step.title}</h3>
          <p class="process__body">{step.body}</p>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .process {
    position: relative;
  }

  .process__line {
    display: none;
  }

  @media (min-width: 1024px) {
    .process__line {
      display: block;
      position: absolute;
      top: 11px;
      left: 0;
      width: 100%;
      height: 4px;
    }

    .process__line-path {
      stroke: var(--color-steel-light);
      stroke-width: 2;
      stroke-dasharray: 1000;
      stroke-dashoffset: 1000;
      transition: stroke-dashoffset var(--transition-draw);
    }

    .process.is-visible .process__line-path {
      stroke-dashoffset: 0;
    }
  }

  .process__steps {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
    position: relative;
  }

  @media (min-width: 1024px) {
    .process__steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .process__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-white);
    font-family: var(--font-mono);
    font-size: 12px;
    margin-bottom: var(--space-3);
  }

  .process__title {
    font-size: var(--text-h3);
    margin-bottom: var(--space-2);
  }

  .process__body {
    color: var(--color-ink-soft);
    font-size: var(--text-small);
  }
</style>

<script>
  const processes = document.querySelectorAll<HTMLElement>("[data-process]");
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 }
    );
    processes.forEach((el) => io.observe(el));
  } else {
    processes.forEach((el) => el.classList.add("is-visible"));
  }
</script>
