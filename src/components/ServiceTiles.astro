---
import { services } from "../data/services.js";
// Asymetrický bento grid — první a čtvrtá dlaždice jsou širší (vizuální
// hierarchie, ne náhoda), zbytek jednotný. Hover "probudí" dlaždici: border
// zesvětlá na accent, glow, blueprint vzor za textem se rozjede, šipka
// posune. Vše funguje i na dotyk (:active / tap), žádná funkce jen na hover.
---

<div class="tiles">
  {
    services.map((s, i) => (
      <a
        href={`/sluzby/${s.slug}/`}
        class:list={["tile", i === 0 && "tile--wide", "reveal"]}
        style={`--reveal-index:${i}`}
        data-event="cta_click"
      >
        <div class="tile__grid" aria-hidden="true" />
        <span class="tile__number">{s.number}</span>
        <div class="tile__body">
          <h3 class="tile__title">{s.title}</h3>
          <p class="tile__desc">{s.short}</p>
        </div>
        <span class="tile__arrow" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M5 15L15 5M15 5H7M15 5V13" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </span>
      </a>
    ))
  }
</div>

<style>
  .tiles {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--color-steel-light);
    border: 1px solid var(--color-steel-light);
  }

  @media (min-width: 640px) {
    .tiles {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .tiles {
      grid-template-columns: repeat(4, 1fr);
    }
    .tile--wide {
      grid-column: span 2;
    }
  }

  .tile {
    position: relative;
    overflow: hidden;
    background: var(--color-void-soft);
    padding: var(--space-5) var(--space-4);
    min-height: 15rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-decoration: none;
    color: var(--color-paper);
    transition: background-color var(--transition-base);
  }

  .tile__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0, 211, 25, 0.16) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 211, 25, 0.16) 1px, transparent 1px);
    background-size: 22px 22px;
    opacity: 0;
    transform: scale(1.08);
    transition: opacity var(--transition-slow), transform var(--transition-slow);
  }

  .tile:hover,
  .tile:focus-visible,
  .tile:active {
    background: var(--color-ink);
  }

  .tile:hover .tile__grid,
  .tile:focus-visible .tile__grid,
  .tile:active .tile__grid {
    opacity: 1;
    transform: scale(1);
  }

  .tile__number {
    position: relative;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--color-steel);
    transition: color var(--transition-base);
  }

  .tile:hover .tile__number,
  .tile:focus-visible .tile__number {
    color: var(--color-accent-bright);
  }

  .tile__body {
    position: relative;
  }

  .tile__title {
    font-size: var(--text-h3);
    margin-bottom: var(--space-2);
  }

  .tile__desc {
    color: var(--color-steel);
    font-size: var(--text-small);
    max-width: 32ch;
  }

  .tile__arrow {
    position: relative;
    align-self: flex-end;
    color: var(--color-steel);
    transition: color var(--transition-base), transform var(--transition-base);
  }

  .tile:hover .tile__arrow,
  .tile:focus-visible .tile__arrow {
    color: var(--color-accent-bright);
    transform: translate(3px, -3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .tile__grid,
    .tile__arrow {
      transition: none;
    }
  }
</style>
