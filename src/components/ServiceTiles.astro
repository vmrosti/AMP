---
import { services } from "../data/services.js";
// Interaktivní přepínač — vlevo (nahoře na mobilu) seznam služeb jako
// vertikální navigace, vpravo velký detailní panel, který se přepíná bez
// reloadu stránky. Technický, "control panel" dojem, ne kartičky.

const icons: Record<string, string> = {
  "zakazkova-vyroba": `<path d="M4 17V7l8-4 8 4v10l-8 4-8-4Z" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linejoin="round"/><path d="M4 7l8 4 8-4M12 11v10" stroke="currentColor" stroke-width="1.4" fill="none"/>`,
  automatizace: `<rect x="4" y="8" width="16" height="10" rx="1.5" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M8 8V5.5A1.5 1.5 0 0 1 9.5 4h5A1.5 1.5 0 0 1 16 5.5V8M9 12.5h6M9 15.5h3" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round"/>`,
  servis: `<path d="M14.7 6.3 17.7 9.3 8 19H5v-3L14.7 6.3Z" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linejoin="round"/><path d="M13 8l3 3" stroke="currentColor" stroke-width="1.4"/>`,
  repase: `<path d="M4 12a8 8 0 0 1 13.7-5.7M20 12a8 8 0 0 1-13.7 5.7" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round"/><path d="M18 3v4h-4M6 21v-4h4" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  "3d-tisk": `<path d="M4 7l8-4 8 4-8 4-8-4Z" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linejoin="round"/><path d="M4 7v10l8 4 8-4V7M12 11v10" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linejoin="round"/>`,
};
---

<div class="selector" data-selector>
  <div class="selector__nav" role="tablist" aria-label="Naše služby">
    {services.map((s, i) => (
      <button
        type="button"
        id={`selector-tab-${s.slug}`}
        class="selector__item"
        role="tab"
        aria-selected={i === 0 ? "true" : "false"}
        aria-controls={`selector-panel-${s.slug}`}
        tabindex={i === 0 ? 0 : -1}
        data-selector-trigger={s.slug}
      >
        <span class="selector__item-icon"><svg viewBox="0 0 24 24" fill="none" set:html={icons[s.slug]} /></span>
        <span class="selector__item-text">
          <span class="selector__item-number">{s.number}</span>
          <span class="selector__item-title">{s.title}</span>
        </span>
        <svg class="selector__item-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M6.5 4l5 5-5 5" stroke="currentColor" stroke-width="1.6" />
        </svg>
      </button>
    ))}
  </div>

  <div class="selector__stage">
    {services.map((s, i) => (
      <div
        class:list={["selector__panel", i === 0 && "is-active"]}
        id={`selector-panel-${s.slug}`}
        role="tabpanel"
        aria-labelledby={`selector-tab-${s.slug}`}
        data-selector-panel={s.slug}
      >
        <span class="selector__panel-icon"><svg viewBox="0 0 24 24" fill="none" set:html={icons[s.slug]} /></span>
        <span class="selector__panel-number font-mono-label">Služba {s.number}</span>
        <h3 class="selector__panel-title">{s.title}</h3>
        <p class="selector__panel-desc">{s.lead}</p>
        <a href={`/sluzby/${s.slug}/`} class="btn btn--primary">Zjistit více</a>
      </div>
    ))}
  </div>
</div>

<style>
  .selector {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-elevated);
    border: 1px solid var(--color-steel-light-on-paper);
  }

  @media (min-width: 900px) {
    .selector {
      grid-template-columns: 20rem 1fr;
      gap: 0;
    }
  }

  .selector__nav {
    display: flex;
    flex-direction: column;
    background: var(--color-white);
  }

  .selector__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border: none;
    border-bottom: 1px solid var(--color-steel-light-on-paper);
    background: transparent;
    text-align: left;
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .selector__item:last-child {
    border-bottom: none;
  }

  .selector__item:hover {
    background: var(--color-paper-alt);
  }

  .selector__item[aria-selected="true"] {
    background: linear-gradient(90deg, rgba(0, 211, 25, 0.1), transparent);
  }

  .selector__item-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-steel-light-on-paper);
    color: var(--color-steel-on-paper);
    transition: border-color var(--transition-fast), color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .selector__item-icon svg,
  .selector__item-icon :global(svg) {
    width: 18px;
    height: 18px;
  }

  .selector__item[aria-selected="true"] .selector__item-icon {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-white);
  }

  .selector__item-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .selector__item-number {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-steel-on-paper);
  }

  .selector__item-title {
    font-family: var(--font-display);
    font-weight: var(--weight-medium);
    font-size: var(--text-body);
    color: var(--color-ink);
  }

  .selector__item-chevron {
    flex-shrink: 0;
    color: var(--color-steel-on-paper);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .selector__item[aria-selected="true"] .selector__item-chevron {
    opacity: 1;
    transform: translateX(0);
    color: var(--color-accent);
  }

  .selector__stage {
    position: relative;
    background: linear-gradient(155deg, var(--color-void) 0%, var(--color-void-soft) 60%, #0f2913 100%);
    padding: var(--space-7) var(--space-6);
    min-height: 22rem;
    display: flex;
    align-items: center;
  }

  .selector__panel {
    display: none;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    max-width: 30rem;
  }

  .selector__panel.is-active {
    display: flex;
    animation: panel-in 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes panel-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .selector__panel.is-active {
      animation: none;
    }
  }

  .selector__panel-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: linear-gradient(150deg, var(--color-accent), var(--color-accent-dark));
    color: var(--color-white);
    box-shadow: 0 0 0 1px rgba(0, 211, 25, 0.3), 0 0 32px rgba(0, 211, 25, 0.35);
    margin-bottom: var(--space-2);
  }

  .selector__panel-icon svg,
  .selector__panel-icon :global(svg) {
    width: 28px;
    height: 28px;
  }

  .selector__panel-number {
    color: var(--color-accent-bright);
  }

  .selector__panel-title {
    font-size: var(--text-h1);
    color: var(--color-paper);
  }

  .selector__panel-desc {
    color: var(--color-steel);
    font-size: var(--text-body-lg);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-selector]").forEach((root) => {
    const triggers = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-selector-trigger]"));
    const panels = root.querySelectorAll<HTMLElement>("[data-selector-panel]");

    function activate(btn: HTMLButtonElement, focus = false) {
      const target = btn.dataset.selectorTrigger;
      triggers.forEach((t) => {
        const isActive = t === btn;
        t.setAttribute("aria-selected", String(isActive));
        t.tabIndex = isActive ? 0 : -1;
      });
      panels.forEach((p) => {
        p.classList.toggle("is-active", p.dataset.selectorPanel === target);
      });
      if (focus) btn.focus();
    }

    triggers.forEach((btn, i) => {
      btn.addEventListener("click", () => activate(btn));

      // Standardní ARIA tabs vzor: šipky doleva/doprava (nahoru/dolů) přepínají
      // mezi taby, Home/End skočí na první/poslední.
      btn.addEventListener("keydown", (e) => {
        let nextIndex: number | null = null;
        if (e.key === "ArrowRight" || e.key === "ArrowDown") nextIndex = (i + 1) % triggers.length;
        else if (e.key === "ArrowLeft" || e.key === "ArrowUp") nextIndex = (i - 1 + triggers.length) % triggers.length;
        else if (e.key === "Home") nextIndex = 0;
        else if (e.key === "End") nextIndex = triggers.length - 1;

        if (nextIndex !== null) {
          e.preventDefault();
          activate(triggers[nextIndex], true);
        }
      });
    });
  });
</script>
