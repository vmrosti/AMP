---
import Button from "./Button.astro";
interface Props {
  title: string;
  subtitle?: string;
  ctaLabel: string;
  ctaHref?: string;
}
const { title, subtitle, ctaLabel, ctaHref = "/kontakt/" } = Astro.props;
---

<section class="cta section section--dark">
  <div class="blueprint-grid" aria-hidden="true"></div>
  <div class="container cta__inner reveal">
    <div>
      <h2 class="cta__title">{title}</h2>
      {subtitle && <p class="cta__subtitle">{subtitle}</p>}
    </div>
    <Button href={ctaHref} variant="primary" class="cta__button">{ctaLabel}</Button>
  </div>
</section>

<style>
  .cta {
    position: relative;
    padding-block: var(--space-8);
    overflow: hidden;
    background: radial-gradient(ellipse 70% 80% at 80% 100%, rgba(0, 211, 25, 0.14), transparent 60%), var(--color-void);
  }

  .cta__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .cta__inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .cta__title {
    font-size: var(--text-h1);
    font-weight: var(--weight-bold);
    letter-spacing: -0.01em;
    color: var(--color-white);
    max-width: 32rem;
  }

  .cta__subtitle {
    margin-top: var(--space-3);
    color: var(--color-steel);
    max-width: 32rem;
  }

  .cta__button {
    flex-shrink: 0;
  }
</style>
