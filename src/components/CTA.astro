---
import Button from "./Button.astro";
interface Props {
  title: string;
  subtitle?: string;
  ctaLabel: string;
  ctaHref?: string;
}
const { title, subtitle, ctaLabel, ctaHref = "/kontakt/" } = Astro.props;
---

<section class="cta section section--dark">
  <div class="container cta__inner reveal">
    <div>
      <h2 class="cta__title">{title}</h2>
      {subtitle && <p class="cta__subtitle">{subtitle}</p>}
    </div>
    <Button href={ctaHref} variant="primary" class="cta__button">{ctaLabel}</Button>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--space-7);
  }

  .cta__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .cta__inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .cta__title {
    font-size: var(--text-h1);
    color: var(--color-white);
    max-width: 32rem;
  }

  .cta__subtitle {
    margin-top: var(--space-3);
    color: var(--color-steel-light);
    max-width: 32rem;
  }

  .cta__button {
    flex-shrink: 0;
  }
</style>
