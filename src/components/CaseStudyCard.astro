---
interface Props {
  href: string;
  title: string;
  obor: string;
  image?: string;
}
const { href, title, obor, image } = Astro.props;
---

<a href={href} class="cs-card reveal" data-event="case_study_open">
  <div class="cs-card__media media-placeholder" aria-hidden="true">
    {image ? <img src={image} alt="" loading="lazy" /> : "FOTO: doplní AMP"}
  </div>
  <div class="cs-card__body">
    <span class="cs-card__obor">{obor}</span>
    <h3 class="cs-card__title">{title}</h3>
    <span class="cs-card__link">Detail realizace <span aria-hidden="true">→</span></span>
  </div>
</a>

<style>
  .cs-card {
    display: block;
    text-decoration: none;
    color: var(--color-ink);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-white);
    box-shadow: var(--shadow-card);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .cs-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
  }

  .cs-card__media {
    aspect-ratio: 4 / 3;
    border-radius: 0;
    border: none;
    border-bottom: 1px solid var(--border-color);
  }

  .cs-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .cs-card:hover .cs-card__media img {
    transform: scale(1.03);
  }

  .cs-card__body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cs-card__obor {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--color-steel-on-paper);
  }

  .cs-card__title {
    font-size: var(--text-h3);
  }

  .cs-card__link {
    font-size: var(--text-small);
    color: var(--color-accent);
    font-weight: var(--weight-medium);
  }
</style>
