---
interface Props {
  before?: string;
  after?: string;
  beforeLabel?: string;
  afterLabel?: string;
}
const { before, after, beforeLabel = "Před", afterLabel = "Po" } = Astro.props;
const hasImages = Boolean(before && after);
---

{
  hasImages ? (
    <div class="ba" data-before-after>
      <div class="ba__frame">
        <img src={after} alt={afterLabel} class="ba__img ba__img--after" />
        <div class="ba__clip" style="width:50%">
          <img src={before} alt={beforeLabel} class="ba__img ba__img--before" />
        </div>
        <span class="ba__tag ba__tag--before">{beforeLabel}</span>
        <span class="ba__tag ba__tag--after">{afterLabel}</span>
      </div>
      <input
        type="range"
        min="0"
        max="100"
        value="50"
        class="ba__range"
        aria-label={`Posuvník ${beforeLabel} / ${afterLabel}`}
      />
    </div>
  ) : (
    <div class="media-placeholder">
      PŘED / PO FOTOGRAFIE: doplní AMP
    </div>
  )
}

<style>
  .ba {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .ba__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    user-select: none;
  }

  .ba__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ba__clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .ba__clip .ba__img {
    width: var(--ba-frame-width, 100%);
    max-width: none;
  }

  .ba__tag {
    position: absolute;
    top: var(--space-2);
    padding: 2px 10px;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    background: rgba(20, 22, 26, 0.7);
    color: var(--color-white);
    border-radius: var(--radius-sm);
  }

  .ba__tag--before {
    left: var(--space-2);
  }
  .ba__tag--after {
    right: var(--space-2);
  }

  .ba__range {
    width: 100%;
    accent-color: var(--color-accent);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-before-after]").forEach((root) => {
    const clip = root.querySelector<HTMLElement>(".ba__clip");
    const frame = root.querySelector<HTMLElement>(".ba__frame");
    const range = root.querySelector<HTMLInputElement>(".ba__range");
    const beforeImg = clip?.querySelector<HTMLImageElement>("img");

    const update = (value: number) => {
      if (!clip || !frame || !beforeImg) return;
      clip.style.width = `${value}%`;
      // Keep the clipped image visually aligned to the full frame width.
      const frameWidth = frame.getBoundingClientRect().width;
      beforeImg.style.width = `${frameWidth}px`;
    };

    range?.addEventListener("input", () => update(Number(range.value)));
    window.addEventListener("resize", () => range && update(Number(range.value)));
    if (range) update(Number(range.value));

    // Touch drag directly on the frame (in addition to native range track support).
    let dragging = false;
    const setFromClientX = (clientX: number) => {
      if (!frame || !range) return;
      const rect = frame.getBoundingClientRect();
      const pct = Math.min(100, Math.max(0, ((clientX - rect.left) / rect.width) * 100));
      range.value = String(pct);
      update(pct);
    };

    frame?.addEventListener("pointerdown", (e) => {
      dragging = true;
      setFromClientX(e.clientX);
    });
    window.addEventListener("pointermove", (e) => {
      if (dragging) setFromClientX(e.clientX);
    });
    window.addEventListener("pointerup", () => (dragging = false));
  });
</script>
