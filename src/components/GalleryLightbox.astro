---
// Masonry galerie s fullscreen lightboxem. Dokud AMP nedodá reálné fotky,
// každá položka je zřetelně označený placeholder — ne stock foto, ne prázdný
// čtverec. Jakmile budou fotky k dispozici, stačí do `items` doplnit `image`.
interface GalleryItem {
  title: string;
  category?: string;
  description?: string;
  image?: string;
  alt?: string;
  size?: "sm" | "md" | "lg";
}
interface Props {
  items: GalleryItem[];
}
const { items } = Astro.props;
// Bez explicitní `size` se velikosti dlaždic střídají, aby vznikl masonry
// efekt s "velkými dominantními fotografiemi" i bez ručního nastavení.
const sizeCycle: Array<"lg" | "md" | "sm"> = ["lg", "sm", "md", "sm", "md", "lg", "sm", "sm"];
---

<div class="gallery-lightbox" data-gallery>
  <div class="gallery-lightbox__grid">
    {
      items.map((item, i) => (
        <button
          type="button"
          class:list={["gallery-lightbox__item", `is-${item.size || sizeCycle[i % sizeCycle.length]}`, "reveal"]}
          style={`--reveal-index:${i % 6}`}
          data-gallery-trigger
          data-index={i}
        >
          {item.image ? (
            <img src={item.image} alt={item.alt || item.title} loading="lazy" decoding="async" />
          ) : (
            <div class="media-placeholder gallery-lightbox__placeholder" aria-hidden="true">
              FOTO: doplní AMP
            </div>
          )}
          <span class="gallery-lightbox__overlay">
            {item.category && <span class="gallery-lightbox__category font-mono-label">{item.category}</span>}
            <span class="gallery-lightbox__title">{item.title}</span>
          </span>
        </button>
      ))
    }
  </div>

  <div class="gallery-lightbox__viewer" id="gallery-viewer" hidden role="dialog" aria-modal="true" aria-label="Prohlížeč fotografií">
    <button type="button" class="gallery-lightbox__close" data-gallery-close aria-label="Zavřít prohlížeč">
      <svg width="22" height="22" viewBox="0 0 22 22"><path d="M4 4l14 14M18 4L4 18" stroke="currentColor" stroke-width="1.6" /></svg>
    </button>
    <button type="button" class="gallery-lightbox__nav gallery-lightbox__nav--prev" data-gallery-prev aria-label="Předchozí fotografie">
      <svg width="28" height="28" viewBox="0 0 28 28"><path d="M17 6l-9 8 9 8" stroke="currentColor" stroke-width="1.6" fill="none" /></svg>
    </button>
    <button type="button" class="gallery-lightbox__nav gallery-lightbox__nav--next" data-gallery-next aria-label="Další fotografie">
      <svg width="28" height="28" viewBox="0 0 28 28"><path d="M11 6l9 8-9 8" stroke="currentColor" stroke-width="1.6" fill="none" /></svg>
    </button>
    <div class="gallery-lightbox__stage">
      <div class="media-placeholder gallery-lightbox__stage-placeholder" id="gallery-viewer-media"></div>
    </div>
    <div class="gallery-lightbox__caption">
      <span class="font-mono-label" id="gallery-viewer-category"></span>
      <p id="gallery-viewer-title"></p>
      <span class="gallery-lightbox__count" id="gallery-viewer-count"></span>
    </div>
  </div>
</div>

<script define:vars={{ items: items.map((it) => ({ title: it.title, category: it.category || "", image: it.image || null, alt: it.alt || it.title })) }}>
  const root = document.currentScript?.closest("[data-gallery]") || document.querySelector("[data-gallery]");
  if (root) {
    const triggers = Array.from(root.querySelectorAll("[data-gallery-trigger]"));
    const viewer = root.querySelector("#gallery-viewer");
    const media = root.querySelector("#gallery-viewer-media");
    const categoryEl = root.querySelector("#gallery-viewer-category");
    const titleEl = root.querySelector("#gallery-viewer-title");
    const countEl = root.querySelector("#gallery-viewer-count");
    const closeBtn = root.querySelector("[data-gallery-close]");
    const prevBtn = root.querySelector("[data-gallery-prev]");
    const nextBtn = root.querySelector("[data-gallery-next]");

    let current = 0;
    let lastTrigger = null;

    function render() {
      const item = items[current];
      if (!item) return;
      media.innerHTML = item.image
        ? `<img src="${item.image}" alt="${item.alt}" style="width:100%;height:100%;object-fit:contain" />`
        : "FOTO: doplní AMP";
      categoryEl.textContent = item.category || "";
      titleEl.textContent = item.title;
      countEl.textContent = `${current + 1} / ${items.length}`;
    }

    function open(index) {
      current = index;
      lastTrigger = triggers[index];
      render();
      viewer.hidden = false;
      document.body.style.overflow = "hidden";
      closeBtn?.focus();
    }

    function close() {
      viewer.hidden = true;
      document.body.style.overflow = "";
      lastTrigger?.focus();
    }

    function step(delta) {
      current = (current + delta + items.length) % items.length;
      render();
    }

    triggers.forEach((t, i) => t.addEventListener("click", () => open(i)));
    closeBtn?.addEventListener("click", close);
    prevBtn?.addEventListener("click", () => step(-1));
    nextBtn?.addEventListener("click", () => step(1));

    viewer?.addEventListener("click", (e) => {
      if (e.target === viewer) close();
    });

    document.addEventListener("keydown", (e) => {
      if (viewer?.hidden) return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowLeft") step(-1);
      if (e.key === "ArrowRight") step(1);
    });

    // Touch swipe
    let touchStartX = 0;
    viewer?.addEventListener("touchstart", (e) => (touchStartX = e.changedTouches[0].clientX), { passive: true });
    viewer?.addEventListener(
      "touchend",
      (e) => {
        const diff = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(diff) > 40) step(diff > 0 ? -1 : 1);
      },
      { passive: true }
    );
  }
</script>

<style>
  .gallery-lightbox__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-flow: dense;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .gallery-lightbox__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .gallery-lightbox__item {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--color-steel-light-on-paper);
    background: var(--color-paper-alt);
    overflow: hidden;
    border-radius: var(--radius-md);
    aspect-ratio: 1 / 1;
    cursor: pointer;
  }

  .gallery-lightbox__item.is-lg {
    aspect-ratio: 1 / 1;
  }

  @media (min-width: 768px) {
    .gallery-lightbox__item.is-lg {
      grid-column: span 2;
      grid-row: span 2;
      aspect-ratio: auto;
    }
    .gallery-lightbox__item.is-md {
      grid-row: span 2;
      aspect-ratio: auto;
    }
  }

  .gallery-lightbox__item img,
  .gallery-lightbox__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: none;
    border-radius: 0;
  }

  .gallery-lightbox__overlay {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3);
    background: linear-gradient(to top, rgba(10, 11, 13, 0.85), transparent);
    color: var(--color-paper);
    text-align: left;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  .gallery-lightbox__item:hover .gallery-lightbox__overlay,
  .gallery-lightbox__item:focus-visible .gallery-lightbox__overlay {
    opacity: 1;
    transform: translateY(0);
  }

  .gallery-lightbox__category {
    color: var(--color-accent-bright);
    font-size: 11px;
  }

  .gallery-lightbox__title {
    font-family: var(--font-display);
    font-weight: var(--weight-medium);
    font-size: var(--text-body);
  }

  /* Viewer / lightbox */
  .gallery-lightbox__viewer {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    background: rgba(10, 11, 13, 0.96);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-5);
  }

  .gallery-lightbox__stage {
    width: min(100%, 68rem);
    max-height: 70vh;
  }

  .gallery-lightbox__stage-placeholder {
    width: 100%;
    height: 70vh;
    max-height: 42rem;
  }

  .gallery-lightbox__caption {
    margin-top: var(--space-4);
    text-align: center;
    color: var(--color-paper);
  }

  .gallery-lightbox__caption p {
    font-size: var(--text-h3);
    font-family: var(--font-display);
    margin-top: var(--space-1);
  }

  .gallery-lightbox__count {
    display: block;
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--color-steel);
  }

  .gallery-lightbox__close,
  .gallery-lightbox__nav {
    position: absolute;
    background: transparent;
    border: 1px solid var(--color-steel-light);
    border-radius: 50%;
    color: var(--color-paper);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }
  .gallery-lightbox__close:hover,
  .gallery-lightbox__nav:hover {
    border-color: var(--color-accent-bright);
    color: var(--color-accent-bright);
  }

  .gallery-lightbox__close {
    top: var(--space-4);
    right: var(--space-4);
  }
  .gallery-lightbox__nav--prev {
    left: var(--space-3);
    top: 50%;
    transform: translateY(-50%);
  }
  .gallery-lightbox__nav--next {
    right: var(--space-3);
    top: 50%;
    transform: translateY(-50%);
  }

  @media (max-width: 640px) {
    .gallery-lightbox__nav {
      width: 36px;
      height: 36px;
    }
  }
</style>
