---
// Jedno místo pro <picture> vzor: WebP (menší, stejná kvalita) s JPEG
// zálohou pro starší prohlížeče. Očekává, že vedle `src.jpg` existuje
// stejnojmenný `src.webp` (viz skript, který je generuje).
interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: "lazy" | "eager";
  width?: number;
  height?: number;
}
const { src, alt, class: className, loading = "lazy", width, height } = Astro.props;
const webpSrc = src.replace(/\.(jpe?g|png)$/i, ".webp");
---

<picture>
  <source srcset={webpSrc} type="image/webp" />
  <img src={src} alt={alt} class={className} loading={loading} decoding="async" width={width} height={height} />
</picture>

<style>
  /* DŮLEŽITÉ: třída předaná zvenčí (`class`) se na tenhle <img> sice napíše,
     ale CSS pravidlo definované ve VOLAJÍCÍ stránce/komponentě ji nikdy
     nenajde — Astro scoping (data-astro-cid-*) se nedědí přes hranice
     komponent. Proto základní vzhled (žádné zdeformování) musí být tady,
     ne spoléhat na to, že si ho doplní volající strana. Volající strana
     smí přidat DALŠÍ vlastnosti (rozměr, border-radius, stín) přes
     `:global(.jejich-trida)` ve svém vlastním <style> bloku.
  */
  img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }
</style>
