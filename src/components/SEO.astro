---
// Centralizovaná SEO hlavička — title, meta description, canonical, OpenGraph, schema.org.
// Každá stránka předává vlastní title/description/schema; nic se nedomýšlí.
// `image`/`imageAlt` umožňují budoucím realizacím mít vlastní OG obrázek
// (viz caseStudies data model) — bez nich se použije brandovaný výchozí og-image.jpg.
// `noindex` slouží pro stránky, které nemají být indexované (např. 404).
interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  schema,
  image = "/og-image.jpg",
  imageAlt = "AMP-stroje — jednoúčelové stroje a automatizace výroby",
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "AMP-stroje, s.r.o.",
  url: Astro.site?.toString(),
  telephone: "+420777911077",
  email: "info@amp-stroje.cz",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Pražákova 1008/69",
    addressLocality: "Brno",
    postalCode: "639 00",
    addressCountry: "CZ",
  },
};

const schemaList = Array.isArray(schema) ? schema : [schema ?? defaultSchema];
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <link rel="canonical" href={canonicalURL} />
)}

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content="cs_CZ" />
<meta property="og:site_name" content="AMP-stroje" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

{schemaList.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}
