---
import Button from "./Button.astro";
import heroIllustration from "../assets/illustrations/hero-illustration.svg?raw";
interface Props {
  headline: string;
  subheadline?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  size?: "large" | "small";
  visual?: boolean;
}
const {
  headline,
  subheadline,
  ctaLabel,
  ctaHref = "/kontakt/",
  secondaryLabel,
  secondaryHref = "/realizace/",
  size = "large",
  visual = false,
} = Astro.props;
---

<section class:list={["hero", `hero--${size}`]}>
  <div class="blueprint-grid" aria-hidden="true"></div>
  <div class="hero__coords" aria-hidden="true">
    <span>N 49.2°</span><span>E 16.6°</span><span>AMP / CNC / AUTOMATION</span>
  </div>

  <div class="container hero__inner">
    <div class="hero__content">
      <h1 class="hero__headline">{headline}</h1>
      {subheadline && <p class="hero__subheadline">{subheadline}</p>}
      {(ctaLabel || secondaryLabel) && (
        <div class="hero__ctas">
          {ctaLabel && <Button href={ctaHref} variant="primary">{ctaLabel}</Button>}
          {secondaryLabel && <Button href={secondaryHref} variant="secondary">{secondaryLabel}</Button>}
        </div>
      )}
    </div>
    {
      visual && (
        <div class="hero__visual">
          <div class="hero__visual-frame glass-panel">
            <div class="hero__visual-media" set:html={heroIllustration} />
            <svg class="hero__corner hero__corner--tl" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 10V2h8" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
            <svg class="hero__corner hero__corner--br" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 14v8h-8" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
          </div>
        </div>
      )
    }
  </div>

  <div class="hero__scroll-hint" aria-hidden="true">
    <span>Scroll</span>
    <svg width="14" height="22" viewBox="0 0 14 22"><rect x="1" y="1" width="12" height="20" rx="6" stroke="currentColor" stroke-width="1.2" fill="none"/><circle class="hero__scroll-dot" cx="7" cy="7" r="1.6" fill="currentColor"/></svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: var(--space-7) var(--space-6);
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 55% at 85% -10%, rgba(14, 122, 29, 0.14), transparent 60%),
      radial-gradient(ellipse 60% 50% at 0% 100%, rgba(0, 211, 25, 0.08), transparent 60%),
      var(--color-paper);
  }

  .hero--large {
    padding-block: var(--space-9) var(--space-8);
    min-height: min(46rem, 92vh);
    display: flex;
    align-items: center;
  }

  .hero__coords {
    position: absolute;
    top: var(--space-4);
    right: var(--container-padding);
    display: none;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--color-steel-on-paper);
  }

  @media (min-width: 1024px) {
    .hero__coords {
      display: flex;
      right: var(--space-6);
    }
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .hero--large .hero__inner {
    grid-template-columns: 1fr;
  }

  @media (min-width: 1024px) {
    .hero--large .hero__inner {
      grid-template-columns: 1.15fr 1fr;
    }
  }

  .hero__content {
    opacity: 0;
    transform: translateY(14px);
    animation: hero-in 700ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__content {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  @keyframes hero-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero--large .hero__headline {
    font-size: var(--text-display);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
    max-width: 16ch;
    color: var(--color-ink);
  }

  .hero--small .hero__headline {
    font-size: var(--text-h1);
    color: var(--color-ink);
  }

  .hero__subheadline {
    margin-top: var(--space-4);
    font-size: var(--text-body-lg);
    color: var(--color-ink-soft);
    max-width: 42ch;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .hero__visual-frame {
    position: relative;
    padding: var(--space-3);
    border-radius: var(--radius-md);
  }

  .hero__visual-media {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: linear-gradient(160deg, #ffffff, var(--color-paper-alt));
  }

  .hero__visual-media :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero__visual-media :global(.gear-spin) {
    transform-box: fill-box;
    transform-origin: center;
  }

  .hero__visual-media :global(.gear-spin--slow) {
    animation: spin-cw 26s linear infinite;
  }

  .hero__visual-media :global(.gear-spin--fast) {
    animation: spin-ccw 14s linear infinite;
  }

  @keyframes spin-cw {
    to { transform: rotate(360deg); }
  }
  @keyframes spin-ccw {
    to { transform: rotate(-360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__visual-media :global(.gear-spin) {
      animation: none;
    }
  }

  .hero__corner {
    position: absolute;
    width: 20px;
    height: 20px;
    color: var(--color-accent-dark);
  }
  .hero__corner--tl { top: -1px; left: -1px; }
  .hero__corner--br { bottom: -1px; right: -1px; }

  .hero__scroll-hint {
    position: absolute;
    left: 50%;
    bottom: var(--space-5);
    transform: translateX(-50%);
    display: none;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--color-steel-on-paper);
  }

  .hero--large .hero__scroll-hint {
    display: flex;
  }

  .hero__scroll-dot {
    animation: scroll-dot 2s ease-in-out infinite;
    transform-origin: center;
  }

  @keyframes scroll-dot {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50% { transform: translateY(7px); opacity: 0.3; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-dot { animation: none; }
  }
</style>
