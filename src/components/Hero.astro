---
import Button from "./Button.astro";
interface Props {
  headline: string;
  subheadline?: string;
  ctaLabel?: string;
  ctaHref?: string;
  size?: "large" | "small";
  visual?: boolean;
}
const {
  headline,
  subheadline,
  ctaLabel,
  ctaHref = "/kontakt/",
  size = "large",
  visual = false,
} = Astro.props;
---

<section class:list={["hero", `hero--${size}`]}>
  <div class="container hero__inner">
    <div class="hero__content">
      <h1 class="hero__headline">{headline}</h1>
      {subheadline && <p class="hero__subheadline">{subheadline}</p>}
      {ctaLabel && (
        <Button href={ctaHref} variant="primary" class="hero__cta">{ctaLabel}</Button>
      )}
    </div>
    {
      visual && (
        <div class="hero__visual media-placeholder">
          FOTO / VIDEO REALIZACE: doplní AMP
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-7) var(--space-6);
  }

  .hero--large {
    padding-block: var(--space-8) var(--space-7);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .hero--large .hero__inner {
    grid-template-columns: 1fr;
  }

  @media (min-width: 1024px) {
    .hero--large .hero__inner {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  .hero__content {
    opacity: 0;
    transform: translateY(12px);
    animation: hero-in 500ms ease forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__content {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  @keyframes hero-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero--large .hero__headline {
    font-size: var(--text-display);
    max-width: 20ch;
  }

  .hero--small .hero__headline {
    font-size: var(--text-h1);
  }

  .hero__subheadline {
    margin-top: var(--space-4);
    font-size: var(--text-body-lg);
    color: var(--color-ink-soft);
    max-width: 40ch;
  }

  .hero__cta {
    margin-top: var(--space-5);
  }

  .hero__visual {
    aspect-ratio: 4 / 3;
  }
</style>
