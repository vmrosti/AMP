---
// Formulář posílá skutečný POST na /api/kontakt (viz src/pages/api/kontakt.js).
// Server-side validace je autoritativní; klientská validace je jen UX vylepšení.
---

<form class="contact-form" id="contact-form" novalidate action="/api/kontakt" method="post">
  <div class="contact-form__row">
    <label for="jmeno">Jméno *</label>
    <input type="text" id="jmeno" name="jmeno" required autocomplete="name" />
    <span class="contact-form__error" data-error-for="jmeno" role="alert"></span>
  </div>

  <div class="contact-form__row">
    <label for="firma">Firma (nepovinné)</label>
    <input type="text" id="firma" name="firma" autocomplete="organization" />
  </div>

  <div class="contact-form__row">
    <label for="email">E-mail *</label>
    <input type="email" id="email" name="email" required autocomplete="email" />
    <span class="contact-form__error" data-error-for="email" role="alert"></span>
  </div>

  <div class="contact-form__row">
    <label for="telefon">Telefon (nepovinné)</label>
    <input type="tel" id="telefon" name="telefon" autocomplete="tel" />
  </div>

  <div class="contact-form__row">
    <label for="zprava">Popis problému *</label>
    <textarea id="zprava" name="zprava" rows="5" required minlength="10"></textarea>
    <span class="contact-form__error" data-error-for="zprava" role="alert"></span>
  </div>

  <div class="contact-form__row contact-form__row--checkbox">
    <input type="checkbox" id="souhlas" name="souhlas" required />
    <label for="souhlas">
      Souhlasím se zpracováním osobních údajů za účelem vyřízení mé poptávky. Více v
      <a href="/ochrana-osobnich-udaju/" target="_blank" rel="noopener">zásadách zpracování osobních údajů</a>.
    </label>
    <span class="contact-form__error" data-error-for="souhlas" role="alert"></span>
  </div>

  <!-- Honeypot proti spamu — skryté pole pro roboty, lidé ho nevidí ani nevyplní -->
  <div class="contact-form__honeypot" aria-hidden="true">
    <label for="predmet">Nevyplňujte toto pole</label>
    <input type="text" id="predmet" name="predmet" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="renderedAt" id="renderedAt" value="" />

  <button type="submit" class="btn btn--primary" id="contact-form-submit">
    <span data-label>Odeslat poptávku</span>
  </button>

  <p class="contact-form__status" role="status" aria-live="polite"></p>
</form>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 32rem;
  }

  .contact-form__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .contact-form__row--checkbox {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
  }

  .contact-form__row--checkbox input {
    margin-top: 4px;
    width: auto;
    accent-color: var(--color-accent);
  }

  .contact-form__row--checkbox label {
    flex: 1;
    font-size: var(--text-small);
    color: var(--color-ink-soft);
  }

  .contact-form__row--checkbox label a {
    color: var(--color-accent);
  }

  .contact-form label {
    font-size: var(--text-small);
    color: var(--color-ink-soft);
  }

  .contact-form input,
  .contact-form textarea {
    font: inherit;
    padding: 12px 16px;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    color: var(--color-ink);
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(0, 211, 25, 0.15);
  }

  .contact-form input[aria-invalid="true"],
  .contact-form textarea[aria-invalid="true"] {
    border-color: var(--color-accent-dark);
  }

  .contact-form__error {
    font-size: var(--text-small);
    color: var(--color-accent-dark);
    min-height: 1.1em;
  }

  .contact-form__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .btn[disabled] {
    opacity: 0.6;
    cursor: not-allowed;
    pointer-events: none;
  }

  .contact-form__status {
    font-size: var(--text-small);
    min-height: 1.2em;
  }

  .contact-form__status[data-state="success"] {
    color: var(--color-success);
  }

  .contact-form__status[data-state="error"] {
    color: var(--color-accent-dark);
  }
</style>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = form?.querySelector<HTMLElement>(".contact-form__status");
  const submitBtn = document.getElementById("contact-form-submit") as HTMLButtonElement | null;
  const submitLabel = submitBtn?.querySelector("[data-label]");
  const renderedAtField = document.getElementById("renderedAt") as HTMLInputElement | null;

  if (renderedAtField) renderedAtField.value = String(Date.now());

  // Předvyplnění zprávy z odkazu (např. z Automation Checku): /kontakt/?zprava=...
  const params = new URLSearchParams(window.location.search);
  const prefill = params.get("zprava");
  const textarea = form?.querySelector<HTMLTextAreaElement>("#zprava");
  if (prefill && textarea) textarea.value = prefill;

  function setFieldError(name: string, message: string) {
    const el = form?.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
    const input = form?.querySelector<HTMLElement>(`[name="${name}"]`);
    if (el) el.textContent = message;
    if (input) input.setAttribute("aria-invalid", message ? "true" : "false");
  }

  function clearErrors() {
    form?.querySelectorAll<HTMLElement>(".contact-form__error").forEach((el) => (el.textContent = ""));
    form?.querySelectorAll<HTMLElement>("[aria-invalid]").forEach((el) => el.removeAttribute("aria-invalid"));
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearErrors();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const honeypot = form.querySelector<HTMLInputElement>("#predmet");
    if (honeypot?.value) return; // tichý zásah proti botům

    if (submitBtn) submitBtn.disabled = true;
    if (submitLabel) submitLabel.textContent = "Odesílám…";
    if (status) {
      status.dataset.state = "";
      status.textContent = "";
    }

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      const result = await response.json().catch(() => ({ ok: false }));

      if (response.ok && result.ok) {
        if (status) {
          status.dataset.state = "success";
          status.textContent = "Děkujeme, poptávku jsme přijali. Ozveme se vám co nejdříve.";
        }
        window.trackEvent?.("contact_form_submit");
        form.reset();
      } else if (response.status === 422 && result.errors) {
        for (const [field, message] of Object.entries(result.errors as Record<string, string>)) {
          setFieldError(field, message);
        }
        if (status) {
          status.dataset.state = "error";
          status.textContent = "Zkontrolujte prosím vyznačená pole.";
        }
      } else {
        if (status) {
          status.dataset.state = "error";
          status.textContent =
            "Odeslání se nezdařilo. Zkuste to prosím znovu, nebo nám zatím napište přímo na e-mail.";
        }
      }
    } catch {
      if (status) {
        status.dataset.state = "error";
        status.textContent =
          "Odeslání se nezdařilo (problém se spojením). Zkuste to prosím znovu, nebo nám napište přímo na e-mail.";
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (submitLabel) submitLabel.textContent = "Odeslat poptávku";
    }
  });
</script>
